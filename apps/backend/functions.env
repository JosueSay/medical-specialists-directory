# Configuracion de la Cloud Function desplegada.
#
# El script de empaquetado copia este archivo como `.env` dentro del artefacto
# de despliegue y Firebase lo aplica como variables de entorno de la funcion.
#
# NINGUN SECRETO VA AQUI: el archivo se versiona. La API key de Google se
# inyecta desde Secret Manager (declarada en `secrets` de la funcion) y el
# identificador del proyecto lo provee el propio runtime.

NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

# La funcion vive detras de Firebase Hosting. Verificado en produccion contra
# el log de rechazo de la whitelist (forwardedFor trae dos entradas: la IP
# real del cliente primero, la del borde de Hosting despues): son dos saltos,
# no uno. Con TRUST_PROXY_HOPS=1 Express resolvia la IP del borde de Hosting
# en vez de la del cliente y rechazaba a todo el mundo.
TRUST_PROXY_HOPS=2
RATE_LIMIT_PER_MINUTE=60

# Vacio significa que solo se aceptan peticiones del mismo origen. La UI
# desplegada llega por el rewrite /api/** de Hosting, asi que no cruza origenes.
# Para consumir la funcion desde otro dominio, agregarlo aqui separado por coma.
CORS_ALLOWED_ORIGINS=

# Control de acceso (RNF-01). IP_WHITELIST no se define a proposito: en
# despliegue la lista vive en el documento de Firestore, editable desde la
# consola sin volver a desplegar.
IP_WHITELIST_ENABLED=true
FIRESTORE_WHITELIST_COLLECTION=config
FIRESTORE_WHITELIST_DOCUMENT=ipWhitelist

# En produccion se lee de Firestore y se llama a Places API de verdad
PERSISTENCE_DRIVER=firestore
PLACES_PROVIDER_DRIVER=google
SEED_ON_STARTUP=false

FIRESTORE_PLACES_COLLECTION=places
FIRESTORE_IMPORT_RUNS_COLLECTION=importRuns
# Turnos de sincronizacion: un documento por combinacion de keyword y zona, que
# es lo que hace atomico el cooldown. Coleccion aparte de importRuns para que
# esa conserve el historial completo de corridas.
FIRESTORE_IMPORT_SLOTS_COLLECTION=importSlots

# Unico destino externo al que la funcion hace peticiones salientes. Se declara
# aunque coincida con el valor por defecto: que el endpoint al que se llama sea
# legible en la configuracion del artefacto, y no solo en el codigo, es lo que
# permite auditarlo en una revision sin abrir el repositorio.
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1

# Tope y filtrado de la sincronizacion: 20 resultados en paginas de 10
PLACES_PAGE_SIZE=10
PLACES_MAX_RESULTS=20
PLACES_INCLUDED_TYPE=doctor
PLACES_STRICT_TYPE_FILTERING=true
PLACES_LANGUAGE_CODE=es
PLACES_REGION_CODE=GT

# Validados por P2 y P3 en la Semana 3: 30 dias de vigencia, 90 de retencion y
# una hora de cooldown. El razonamiento de cada uno esta en
# docs/design.md, seccion de politica de frescura.
#
# El cooldown es por combinacion de keyword y zona, no global: repetir la misma
# busqueda antes de una hora responde 429 sin llamar a Google, mientras que otra
# keyword o la misma en otra zona pasa sin espera.
#
# La purga de retencion solo corre durante una sincronizacion. Sin importaciones
# no se ejecuta, y automatizarla queda fuera de alcance: haria falta una funcion
# programada con Cloud Scheduler.
PLACES_TTL_MINUTES=43200
PLACES_RETENTION_HOURS=2160
SYNC_COOLDOWN_MINUTES=60

# ---------------------------------------------------------------------------
# Lo que NO se declara aqui, y por que
#
# El criterio de este archivo es declarar cada valor aunque coincida con el que
# trae el esquema, de modo que se lea completo sin consultar el codigo. Estas
# siete son la excepcion, y cada una por un motivo distinto:
#
#   BACKEND_PORT       No tiene efecto. En despliegue la funcion no abre un
#                      socket: Cloud Run recibe la peticion y se la entrega al
#                      handler. Declararlo sugeriria un puerto que nadie
#                      escucha, que confunde mas de lo que documenta.
#
#   API_BASE_PATH      Se deriva del contrato (`API_VERSION` en @msd/contracts),
#                      de donde tambien lo toma el frontend. Fijarlo aqui
#                      permitiria subir la version del contrato y que la UI
#                      llamara a una ruta que la funcion ya no sirve.
#
#   GOOGLE_MAPS_API_KEY  Es secreto. Vive en Secret Manager y el runtime lo
#                      inyecta; la funcion lo declara en `secrets`.
#
#   FIREBASE_PROJECT_ID  Lo provee el runtime. Fijarlo ataria el artefacto a un
#                      proyecto concreto, y cada integrante despliega al suyo.
#
#   IP_WHITELIST       En despliegue la lista vive en el documento de Firestore
#                      para poder cambiarla sin redesplegar. Esta variable tiene
#                      prioridad sobre esa fuente, asi que definirla aqui
#                      anularia justamente lo que se busca.
#
#   FIRESTORE_EMULATOR_HOST        Vacio significa Firestore real. Cualquier
#   GOOGLE_APPLICATION_CREDENTIALS valor haria que la funcion desplegada
#                      escribiera en un emulador inexistente o buscara una
#                      credencial de archivo en vez de usar su identidad.
# ---------------------------------------------------------------------------
