{
  "name": "@msd/backend",
  "version": "0.1.0",
  "description": "API HTTP del directorio de especialistas medicos, con arquitectura limpia",
  "private": true,
  "type": "module",
  "main": "dist/functions.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve:functions": "pnpm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "@msd/contracts": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "zod": "^4.1.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
