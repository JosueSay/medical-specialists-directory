{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // `node` es necesario para vite.config.ts y vitest.config.ts, que corren en Node
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noEmit": true,
    // Sin baseUrl: las rutas se resuelven desde este archivo (baseUrl queda obsoleto en TypeScript 7)
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "*.config.ts"]
}
