# Plantilla de variables de entorno del proyecto.
# Copiar a .env y completar los valores reales. El archivo .env nunca se versiona.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Entorno de ejecucion
# ---------------------------------------------------------------------------
# NODE_ENV afecta el comportamiento de las librerias (development | production | test)
NODE_ENV=development
# APP_ENV identifica el entorno logico del despliegue (local | development | staging | production)
APP_ENV=local
# Nivel minimo de log que se escribe (debug | info | warn | error)
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Puertos: unico lugar donde se cambian, tanto en local como en Docker
# ---------------------------------------------------------------------------
BACKEND_PORT=4000
FRONTEND_PORT=5173
FIRESTORE_EMULATOR_PORT=8080
FIREBASE_EMULATOR_UI_PORT=4001
# Emulador de Functions: valida la funcion como Cloud Function antes de desplegar.
# El desarrollo diario corre contra BACKEND_PORT; este emulador se usa para
# verificar el empaquetado real antes de cada entrega.
FUNCTIONS_EMULATOR_PORT=5001
HOSTING_EMULATOR_PORT=5000

# ---------------------------------------------------------------------------
# Backend HTTP
# ---------------------------------------------------------------------------
API_BASE_PATH=/api/v1
# Origenes permitidos por CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Saltos de proxy confiables para resolver la IP real del cliente (Firebase Hosting usa 1)
TRUST_PROXY_HOPS=1
# Peticiones por minuto y por IP antes de responder 429
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Whitelist de IPs (RNF-01)
# En produccion la lista vive en un documento de Firestore editable desde la
# consola, para cambiar de red sin volver a desplegar. No existe endpoint de
# administracion: ver la seccion de seguridad en docs/design.md.
# IP_WHITELIST solo se usa en desarrollo local y tiene prioridad sobre el resto.
# Acepta IPs sueltas y rangos CIDR separados por coma.
# ---------------------------------------------------------------------------
IP_WHITELIST_ENABLED=true
IP_WHITELIST=
FIRESTORE_WHITELIST_COLLECTION=config
FIRESTORE_WHITELIST_DOCUMENT=ipWhitelist

# ---------------------------------------------------------------------------
# Seleccion de adaptadores (arquitectura limpia: se cambia infraestructura sin tocar el dominio)
# ---------------------------------------------------------------------------
# Donde se persisten los lugares: memory | firestore
PERSISTENCE_DRIVER=memory
# De donde se traen los lugares: mock | google
PLACES_PROVIDER_DRIVER=mock
# Carga datos de ejemplo al arrancar cuando PERSISTENCE_DRIVER=memory
SEED_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Google Maps Platform, Places API
# Cada integrante usa su propia API key. Nunca se versiona ni llega al cliente.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
# Paginacion de la sincronizacion (RF-02): paginas de 10 hasta 20 resultados.
# Son 2 llamadas facturables por sincronizacion. El limite de 20 lo fija el enunciado.
PLACES_PAGE_SIZE=10
PLACES_MAX_RESULTS=20
# Filtrado de resultados: descarta farmacias, tiendas y negocios no medicos
PLACES_INCLUDED_TYPE=doctor
PLACES_STRICT_TYPE_FILTERING=true
PLACES_LANGUAGE_CODE=es
PLACES_REGION_CODE=GT

# ---------------------------------------------------------------------------
# Politica de frescura del cache
# Solo el placeId puede almacenarse indefinidamente segun las politicas de
# Places API; el resto de campos se purga al superar la retencion.
# Valores de desarrollo: TTL corto para observar la transicion a stale sin esperar.
# Valores de demo sugeridos: TTL 43200 (30 dias), retencion 2160 (90 dias), cooldown 60.
# ---------------------------------------------------------------------------
PLACES_TTL_MINUTES=30
PLACES_RETENTION_HOURS=24
SYNC_COOLDOWN_MINUTES=1

# ---------------------------------------------------------------------------
# Firebase / Firestore
# Solo se usan cuando PERSISTENCE_DRIVER=firestore
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIRESTORE_PLACES_COLLECTION=places
FIRESTORE_IMPORT_RUNS_COLLECTION=importRuns
# Apuntar al emulador en desarrollo; vacio significa Firestore real
# En Docker con el perfil emulator: mnemosyne:8080
FIRESTORE_EMULATOR_HOST=
# Ruta al service account cuando se usa Firestore real
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Frontend: solo variables con prefijo VITE_ llegan al navegador.
# Nunca poner secretos aqui, quedan expuestos en el bundle.
# ---------------------------------------------------------------------------
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_DEFAULT_LOCALE=es
VITE_DEFAULT_THEME=system
VITE_DEFAULT_PAGE_SIZE=10

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=msd
# Polling de archivos: necesario para que el hot reload funcione sobre volumenes montados en WSL2
WATCH_USE_POLLING=true
WATCH_POLL_INTERVAL=300
