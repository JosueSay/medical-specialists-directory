rules_version = '2';

// El cliente nunca habla con Firestore: todo acceso pasa por la API (Cloud Functions), que usa el SDK admin y no esta sujeta a estas reglas. Por eso se niega todo acceso directo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
